# 复制为 .env 后填写（本地调试用；GitHub Actions 请改用 Repository Secrets）
# 默认通知渠道：telegram | dingtalk | webhook | serverchan | none
NOTIFY_CHANNEL=telegram

# Telegram（全球可用，国内需代理）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 钉钉机器人（国内原生可达，推荐国内用户使用）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 通用 Webhook（兼容 ntfy / Discord / Bark 等，POST JSON {text,title}）
NOTIFY_WEBHOOK=

# Server酱（推送到微信，免费额度有限）
SERVERCHAN_SENDKEY=
